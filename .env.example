# Copy to .env.local and fill in. Only VITE_-prefixed values reach the browser —
# never put secret keys in a VITE_ variable.

# Public site URL, no trailing slash (e.g. https://f2acars.com).
# Used for canonical URLs, Open Graph images, sitemap.xml and robots.txt.
VITE_SITE_URL=

# Optional: Google Maps Embed API key, restricted to your domain (HTTP referrer).
# Without it the contact page shows a map placeholder with an "Open in Google Maps" link.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Future: Supabase (see supabase/schema.sql). The anon key is public by design;
# the service-role key must only ever live on a server.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Server-side only (serverless function / backend), never VITE_-prefixed:
# EMAIL_API_KEY=
# CRM_API_KEY=
